CODEVO_PORT=4318
CODEVO_NAME=Linux runner

# Used only with compose.execution.yaml. Provider authentication is performed
# inside the execution container and persists in the runner data volume.
CODEX_CLI_VERSION=0.154.0
CLAUDE_CLI_VERSION=2.1.270
CODEVO_EXECUTION_MEMORY=4g
CODEVO_EXECUTION_CPUS=2.0

# Maximum time for one provider run, including waits for your answers.
# Default: 12 hours. Allowed: 60000 (1 minute) to 604800000 (7 days).
CODEVO_EXECUTION_TIMEOUT_MS=43200000
