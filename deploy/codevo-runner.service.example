[Unit]
Description=Codevo Runner

[Service]
Type=simple
WorkingDirectory=%h/Developer/codevo-runner
EnvironmentFile=%h/.config/codevo-runner/runner.env
# Replace this path with the absolute Node 24.13+ (24.x) executable path.
ExecStart=/absolute/path/to/node dist/src/main.js
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=35
UMask=0077

[Install]
WantedBy=default.target
